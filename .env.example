# GitHub token with `public_repo` scope (required to fetch issues without hitting low rate limits)
GITHUB_TOKEN=your_github_token_here

# TinyLLaMA endpoint (optional — defaults to the project's public HF Space)
OLLAMA_API_URL=https://aditya69690-100-hack.hf.space/api/generate

# Optional: use Groq's free-tier API instead of the HF Space (faster, more reliable).
# If set, Groq is tried first and the HF Space is used only as a fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Web search enrichment (optional)
# Uses DuckDuckGo by default — no key required. Set to "false" to disable web search.
USE_WEB_SEARCH=true

# Optional fallback search provider if DuckDuckGo is unavailable
TAVILY_API_KEY=
